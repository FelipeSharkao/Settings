{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-claude-auth",
        "@mohak34/opencode-notifier",
        "@tarquinen/opencode-dcp",
        "@dietrichgebert/ponytail",
        "superpowers@git+https://github.com/obra/superpowers.git",
    ],
    "lsp": {},
    "formatter": {},
    "agent": {
        "explore": { "model": "opencode-go/deepseek-v4-pro" },
        "title": { "model": "opencode-go/deepseek-v4-pro" },
        "summary": { "model": "opencode-go/deepseek-v4-pro" },
        "compaction": { "model": "opencode-go/deepseek-v4-pro" },
    },
    "permission": {
        "bash": {
            "*": "allow",
            "git *": "ask",
            "git log *": "allow",
            "git diff *": "allow",
            "git show *": "allow",
            "git rev-parse *": "allow",
            "git add *": "allow",
            "git stash *": "allow",
            "git grep *": "allow",
            "git ls-files *": "allow",
        },
    },
    "mcp": {
        "codegraph": {
            "type": "local",
            "command": ["codegraph", "serve", "--mcp"],
            "enabled": true,
        },
    },
}
